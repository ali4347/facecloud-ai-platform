# ============================================================
# FaceCloud — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values.
# cp .env.example .env
#
# NOTE: Supabase MCP is NOT required for this project.
# Local development uses Docker PostgreSQL (see docker-compose.yml).
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
NODE_ENV=development
PORT=3001

# ------------------------------------------------------------
# PostgreSQL Database (Docker local dev)
# ⚠ Do NOT use Supabase MCP. Use the Docker container below.
# Start with: docker compose up -d
# ------------------------------------------------------------
POSTGRES_USER=facecloud
POSTGRES_PASSWORD=facecloud
POSTGRES_DB=facecloud_db
POSTGRES_PORT=5432

# Prisma uses this DATABASE_URL for all migrations and queries.
DATABASE_URL="postgresql://facecloud:facecloud@localhost:5432/facecloud_db?schema=public"

# ------------------------------------------------------------
# Redis (Docker local dev)
# Used by BullMQ for job queue management.
# ------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------
# JWT Authentication
# Replace with strong random secrets in production!
# Generate with: openssl rand -hex 64
# ------------------------------------------------------------
JWT_SECRET="change-me-in-production-use-openssl-rand-hex-64"
JWT_REFRESH_SECRET="change-me-in-production-use-openssl-rand-hex-64-refresh"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ------------------------------------------------------------
# Cloud Storage (AWS S3 / Cloudflare R2)
# Leave blank for local development — mock URLs will be used.
# ------------------------------------------------------------
STORAGE_PROVIDER="local"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
AWS_S3_REGION=""

# Cloudflare R2 (alternative to S3)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""

# ------------------------------------------------------------
# Email (SMTP)
# Leave blank in local dev — emails will be logged to console.
# ------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@facecloud.ai"

# ------------------------------------------------------------
# Frontend URL (CORS allowed origin)
# ------------------------------------------------------------
FRONTEND_URL="http://localhost:5173"
