# FaceCloud frontend — environment
#
# This repository is the browser application only. It talks to the FaceCloud
# backend over HTTP and never touches a database directly, so there is no
# DATABASE_URL, JWT secret or SMTP setting here. Those belong to the backend:
# https://github.com/ijaz-student021/FaceCloud_backend
#
# Copy to .env and adjust. Vite only exposes variables prefixed with VITE_.

# Where the API lives. No trailing slash.
#   local backend:  http://127.0.0.1:8000
#   production:     https://api.your-domain.example
VITE_API_URL=http://127.0.0.1:8000

# Leave unset (or false) to keep using the built-in mock data instead of the
# API. Lets the demo dashboard stay populated while screens are migrated.
VITE_USE_API=false
