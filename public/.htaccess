# FaceCloud — Apache / LiteSpeed configuration (the live host is Hostinger)
#
# The app is a single-page application: React Router owns every path, and the
# only HTML on the server is index.html. Without the rules below, opening
# /admin, /dashboard or /moderator directly — or refreshing while on one — asks
# the host for a file that does not exist, and it answers with its own 404 page
# instead of the app.
#
# Vite copies everything in public/ into dist/, so this ships with each build.
# Note for manual uploads: this file starts with a dot, so file managers and FTP
# clients often hide it. It must reach the web root or deep links break again.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Real files and directories are served as they are: hashed bundles,
  #    branding images, the hero videos, robots.txt, sitemap.xml.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Everything else is a client-side route, so hand it the app shell —
  #    except requests that look like a static file. Those are left alone and
  #    404 naturally: a missing bundle should report as missing, not come back
  #    as HTML, which the browser then reports as a MIME type error.
  RewriteCond %{REQUEST_URI} !^/assets/
  RewriteCond %{REQUEST_URI} !\.(js|mjs|css|map|json|xml|txt|png|jpe?g|gif|svg|webp|avif|ico|woff2?|ttf|eot|mp4|webm)$ [NC]
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # index.html names the hashed bundles, so a cached copy can point at files
  # that no longer exist after a deploy.
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Those bundle names change on every build, so a long cache is safe.
  <FilesMatch "\.(js|mjs|css|woff2?|ttf|eot|svg|png|jpe?g|webp|avif|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
