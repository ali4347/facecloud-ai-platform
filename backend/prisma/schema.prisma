// ============================================================
// FaceCloud — Prisma Schema
// Database: PostgreSQL (Docker local dev / cloud production)
// ORM: Prisma v5
//
// Local development: start DB with `docker compose up -d`
// Supabase MCP is NOT required for this project.
// ============================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  USER
  ADMIN
  MODERATOR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
}

enum QualityStatus {
  PASSED
  FAILED
  PENDING_REVIEW
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationType {
  JOB_COMPLETE
  JOB_FAILED
  REVIEW_REQUIRED
  SYSTEM_ALERT
  ACCOUNT_UPDATE
}

enum StepStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  SKIPPED
}

// ============================================================
// MODEL: User
// Core user account record.
// ============================================================
model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(USER)
  status       UserStatus @default(PENDING_VERIFICATION)
  avatarUrl    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  sessions          Session[]
  uploads           Upload[]
  images            Image[]
  processingJobs    ProcessingJob[]
  notifications     Notification[]
  activityLogs      ActivityLog[]
  adminAuditLogs    AdminAuditLog[]

  @@map("users")
}

// ============================================================
// MODEL: Session
// JWT refresh token / active session tracking.
// ============================================================
model Session {
  id           String   @id @default(uuid())
  refreshToken String   @unique
  ipAddress    String?
  userAgent    String?
  isRevoked    Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@map("sessions")
}

// ============================================================
// MODEL: Upload
// Raw file upload record before processing.
// ============================================================
model Upload {
  id           String   @id @default(uuid())
  originalName String
  mimeType     String
  sizeBytes    Int
  storageKey   String   // S3/R2 object key
  uploadType   String   // "single" | "multiple" | "zip"
  uploadedAt   DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Each upload spawns one processing job
  processingJob ProcessingJob?

  @@index([userId])
  @@map("uploads")
}

// ============================================================
// MODEL: Image
// Processed image record after pipeline completion.
// ============================================================
model Image {
  id            String        @id @default(uuid())
  filename      String
  rawUrl        String        // S3/R2 path to raw image
  enhancedUrl   String?       // S3/R2 path to enhanced image
  faceDetected  Boolean       @default(false)
  faceCount     Int           @default(0)
  qualityStatus QualityStatus @default(PENDING_REVIEW)
  rejectionReason String?
  matchedConfidence Float?    // Highest similarity percentage (0-100)
  uploadedAt    DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relations
  detectedFaces      DetectedFace[]
  qualityCheck       ImageQualityCheck?
  faceEmbeddings     FaceEmbedding[]
  personFolderImages PersonFolderImage[]
  moderatorReviews   ModeratorReview[]

  @@index([userId])
  @@index([qualityStatus])
  @@map("images")
}

// ============================================================
// MODEL: DetectedFace
// Individual face bounding box detected in an image.
// ============================================================
model DetectedFace {
  id          String @id @default(uuid())
  faceIndex   Int    // 0-based index within the image
  boundingBox Json   // { x, y, width, height } in pixels
  landmarks   Json?  // MediaPipe landmark coordinates
  confidence  Float  // Detection confidence 0-1

  imageId String
  image   Image  @relation(fields: [imageId], references: [id], onDelete: Cascade)

  // A detected face may have one embedding
  faceEmbedding FaceEmbedding?

  @@index([imageId])
  @@map("detected_faces")
}

// ============================================================
// MODEL: ImageQualityCheck
// Sharpness, brightness, face-size quality scores.
// ============================================================
model ImageQualityCheck {
  id              String        @id @default(uuid())
  blurScore       Float         // Laplacian variance (higher = sharper)
  brightnessScore Float         // Mean luminosity (0-255 normalized to 0-100)
  faceSizeScore   Float         // Face bounding-box ratio score (0-100)
  overallScore    Float         // Weighted composite score
  status          QualityStatus
  failureReasons  String[]      // e.g. ["blur_too_high", "face_too_small"]
  checkedAt       DateTime      @default(now())

  imageId String @unique
  image   Image  @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@map("image_quality_checks")
}

// ============================================================
// MODEL: FaceEmbedding
// 128-D InsightFace/ArcFace vector for identity clustering.
// ============================================================
model FaceEmbedding {
  id        String   @id @default(uuid())
  vector    Float[]  // 128-D embedding vector
  modelName String   @default("InsightFace-ArcFace") // model used
  createdAt DateTime @default(now())

  imageId String
  image   Image  @relation(fields: [imageId], references: [id], onDelete: Cascade)

  detectedFaceId String?      @unique
  detectedFace   DetectedFace? @relation(fields: [detectedFaceId], references: [id])

  @@index([imageId])
  @@map("face_embeddings")
}

// ============================================================
// MODEL: PersonFolder
// Identity group / cluster for matched face embeddings.
// ============================================================
model PersonFolder {
  id          String   @id @default(uuid())
  label       String   // e.g. "Person Folder #3"
  coverImageUrl String? // URL of the representative face image
  imageCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Many-to-many with Image
  personFolderImages PersonFolderImage[]

  @@map("person_folders")
}

// ============================================================
// MODEL: PersonFolderImage
// Join table — images belong to one or more person folders.
// (Multi-face images are attached to ALL matching folders.)
// ============================================================
model PersonFolderImage {
  id               String   @id @default(uuid())
  matchedConfidence Float   // Similarity score for this specific match
  assignedAt       DateTime @default(now())

  personFolderId String
  personFolder   PersonFolder @relation(fields: [personFolderId], references: [id], onDelete: Cascade)

  imageId String
  image   Image  @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@unique([personFolderId, imageId])
  @@index([personFolderId])
  @@index([imageId])
  @@map("person_folder_images")
}

// ============================================================
// MODEL: ProcessingJob
// Async job record for image processing pipeline.
// ============================================================
model ProcessingJob {
  id            String    @id @default(uuid())
  status        JobStatus @default(PENDING)
  uploadType    String    // "single" | "multiple" | "zip"
  totalImages   Int       @default(1)
  processedImages Int     @default(0)
  progress      Int       @default(0) // 0-100
  failureReason String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  uploadId String? @unique
  upload   Upload? @relation(fields: [uploadId], references: [id])

  // Relations
  steps ProcessingStep[]

  @@index([userId])
  @@index([status])
  @@map("processing_jobs")
}

// ============================================================
// MODEL: ProcessingStep
// Individual pipeline stage within a processing job.
// ============================================================
model ProcessingStep {
  id          String     @id @default(uuid())
  stepName    String     // e.g. "zero_dce", "face_detection", "quality_check"
  stepIndex   Int        // Order within the pipeline (0-based)
  status      StepStatus @default(PENDING)
  durationMs  Int?       // Execution time in milliseconds
  errorMessage String?
  metadata    Json?      // Stage-specific output data
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())

  processingJobId String
  processingJob   ProcessingJob @relation(fields: [processingJobId], references: [id], onDelete: Cascade)

  @@index([processingJobId])
  @@map("processing_steps")
}

// ============================================================
// MODEL: Notification
// User-facing system notifications.
// ============================================================
model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  metadata  Json?            // e.g. { jobId, imageId }
  createdAt DateTime         @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

// ============================================================
// MODEL: ActivityLog
// Per-user action event stream (user-visible audit trail).
// ============================================================
model ActivityLog {
  id        String   @id @default(uuid())
  action    String   // e.g. "image_uploaded", "folder_created", "download_started"
  resource  String   // e.g. "image", "job", "folder"
  resourceId String? // ID of the affected resource
  ipAddress String?
  userAgent String?
  metadata  Json?    // Additional context
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@map("activity_logs")
}

// ============================================================
// MODEL: AdminAuditLog
// Immutable admin-level audit trail. Never deleted.
// ============================================================
model AdminAuditLog {
  id         String   @id @default(uuid())
  action     String   // e.g. "user_suspended", "role_changed", "system_config_updated"
  resource   String   // e.g. "user", "system", "moderator"
  resourceId String?
  ipAddress  String
  details    String?  // Human-readable description
  metadata   Json?    // Raw payload snapshot
  createdAt  DateTime @default(now())

  // Admin who performed the action
  adminId String
  admin   User   @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

// ============================================================
// MODEL: ModeratorReview
// Human-in-the-loop review for borderline/flagged images.
// ============================================================
model ModeratorReview {
  id           String       @id @default(uuid())
  status       ReviewStatus @default(PENDING)
  riskLevel    RiskLevel    @default(MEDIUM)
  feedback     String?      // Moderator notes / rejection reason
  decidedAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  imageId String
  image   Image  @relation(fields: [imageId], references: [id], onDelete: Cascade)

  // Moderator who made the decision (null if pending)
  moderatorId String?

  @@index([status])
  @@index([imageId])
  @@map("moderator_reviews")
}
